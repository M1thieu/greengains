---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const PLAY_STORE = 'https://play.google.com/store/apps/details?id=com.eremat.greengains';
---

<Layout title="GreenGains — Know what your city is doing to you">
  <Nav />

  <!-- Hero -->
  <section class="relative flex min-h-screen flex-col items-center justify-center px-6 pt-24 text-center">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(16,185,129,0.10),transparent)]" />

    <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-primary">Urban sensing</p>

    <h1 class="mx-auto max-w-3xl text-5xl font-bold leading-[1.1] tracking-tight md:text-7xl">
      Know what your city<br /><span class="text-primary">is doing to you.</span>
    </h1>

    <p class="mx-auto mt-7 max-w-lg text-lg leading-relaxed text-muted">
      Your phone has sensors it never uses. GreenGains uses them.
      Light levels, road vibration, air pressure — read passively as you go.
      No new habits. Nothing to open.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={PLAY_STORE}
        target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-semibold text-bg transition-opacity hover:opacity-90"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3.18 23.76a2 2 0 0 0 2.84-.02l.05-.05 10.14-10.14-2.83-2.83L3.18 20.87a2 2 0 0 0 0 2.89ZM20.47 9.39l-2.75-1.57-3.18 3.18 3.18 3.18 2.76-1.58a2 2 0 0 0 0-3.21ZM2.01 1.05a2 2 0 0 0-.01 2.72L13.38 15.1l2.83-2.83L4.85 1.06A2 2 0 0 0 2.01 1.05Zm5.17 11.45L2.01 17.67v.01a2 2 0 0 0 2.84 2.83l5.29-5.29-2.96-2.72Z"/>
        </svg>
        Download — Android
      </a>
      <a
        href="/dashboard/#map"
        class="rounded-lg border border-border px-6 py-3 font-semibold text-white transition-colors hover:border-primary/60"
      >
        See the map
      </a>
    </div>

    <p class="mt-10 text-xs text-muted">Free. No account needed to see the map.</p>
  </section>

  <!-- What it is -->
  <section class="border-t border-border">
    <div class="mx-auto grid max-w-6xl gap-px md:grid-cols-3" style="background:theme('colors.border')">
      {[
        { label: 'Runs in background', body: 'You never open it. It reads sensors while you live your life — commute, walk, cycle.' },
        { label: 'Your routes. Not averages.', body: 'The map shows your zones specifically. Not city-wide stats — your actual streets.' },
        { label: 'GDPR. No PII sold.', body: 'Readings are anonymized at ingest. We don\'t know who mapped what.' },
      ].map(item => (
        <div class="bg-bg px-8 py-10">
          <p class="font-semibold text-white">{item.label}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- The sensors -->
  <section class="mx-auto max-w-6xl px-6 py-28">
    <h2 class="text-3xl font-bold md:text-4xl">Four things your phone already knows.</h2>
    <p class="mt-4 max-w-lg text-muted">
      It's been measuring these all along. GreenGains is the first app that makes them useful.
    </p>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      <div class="rounded-xl border border-border bg-surface p-7">
        <div class="mb-5 h-1.5 w-10 rounded-full bg-light" />
        <h3 class="font-semibold text-light">Ambient light</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Light pollution levels on your usual routes. Which streets are bright at midnight. Which neighborhoods stay dark.
          The kind of data that takes researchers years to collect — yours in a week of commuting.
        </p>
      </div>

      <div class="rounded-xl border border-border bg-surface p-7">
        <div class="mb-5 h-1.5 w-10 rounded-full bg-movement" />
        <h3 class="font-semibold text-movement">Movement quality</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          How smooth your movement is end-to-end. Reflects traffic flow, pedestrian density, stop-and-go patterns.
          Different at 8am and 8pm on the same street.
        </p>
      </div>

      <div class="rounded-xl border border-border bg-surface p-7">
        <div class="mb-5 h-1.5 w-10 rounded-full bg-pressure" />
        <h3 class="font-semibold text-pressure">Air pressure</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Barometric readings that change with altitude, weather fronts, and whether you're indoors or out.
          Useful for correlating with health studies and urban climate modeling.
        </p>
      </div>

      <div class="rounded-xl border border-border bg-surface p-7">
        <div class="mb-5 h-1.5 w-10 rounded-full bg-quality" />
        <h3 class="font-semibold text-quality">Road vibration</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Accelerometer data that shows surface quality. Potholes, cobblestones, smooth asphalt —
          measurable from your pocket, no special hardware needed.
        </p>
      </div>
    </div>
  </section>

  <!-- Map section -->
  <section id="map" class="border-y border-border bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
        <div class="max-w-lg">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary">Coverage map</p>
          <h2 class="mt-3 text-3xl font-bold md:text-4xl">Built by people going about their day.</h2>
          <p class="mt-5 text-muted leading-relaxed">
            Every hex on the map is a real zone contributed by a real person.
            The more people map an area, the sharper the picture.
            Right now it's sparse in places — that's honest, not a bug.
          </p>
          <a
            href="/dashboard/#map"
            class="mt-8 inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-primary/60"
          >
            Open the map
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        <div class="flex flex-col gap-6 md:w-64">
          {[
            { n: '~174m', label: 'Personal hex resolution' },
            { n: '~461m', label: 'Community resolution' },
            { n: '30d', label: 'Rolling data window' },
          ].map(s => (
            <div class="border-l-2 border-primary/30 pl-4">
              <p class="text-2xl font-bold text-primary">{s.n}</p>
              <p class="text-sm text-muted">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- For cities teaser -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="rounded-2xl border border-border p-8 md:p-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">For organizations</p>
      <h2 class="mt-3 max-w-xl text-2xl font-bold md:text-3xl">
        Cities and researchers are using this data.
      </h2>
      <p class="mt-4 max-w-lg text-muted leading-relaxed">
        The same sensor layer, queryable by OSM boundary polygon.
        Urban planners, environmental agencies, real estate.
        If you need street-level environmental intelligence at scale, that's what this is.
      </p>
      <a href="/business" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-primary transition-colors">
        See the data API
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative overflow-hidden border-t border-border px-6 py-28 text-center">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_80%_at_50%_100%,rgba(16,185,129,0.07),transparent)]" />
    <h2 class="text-4xl font-bold md:text-5xl">Start seeing your city.</h2>
    <p class="mx-auto mt-5 max-w-sm text-muted">
      Android. Free. Takes 30 seconds to install and you're done.
    </p>
    <a
      href={PLAY_STORE}
      target="_blank" rel="noopener noreferrer"
      class="mt-9 inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 font-semibold text-bg transition-opacity hover:opacity-90"
    >
      Get on Android
    </a>
  </section>

  <Footer />
</Layout>
