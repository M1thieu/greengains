---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const API_BASE = 'https://greengains-production.up.railway.app';
---

<Layout
  title="GreenGains Data — Passive Urban Sensing at Street Scale"
  description="Five sensor layers from ordinary phones: vehicle road vibration, night/day light lux, magnetic field, WiFi density, and air pressure. H3 hexes, transport-mode filtered, REST API. No fieldwork."
>
  <Nav />

  <!-- Hero -->
  <section class="relative mx-auto max-w-6xl px-6 pt-36 pb-20">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_40%_at_20%_30%,rgba(16,185,129,0.06),transparent)]" />
    <p class="text-xs font-semibold uppercase tracking-widest text-primary">Passive urban sensing</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
      Every commuter is a road inspector.<br />
      <span class="text-primary">We read the data they already collect.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
      Five sensor layers from ordinary phones — road vibration, ambient light, air pressure,
      magnetic field, and movement flow — passively collected as people go about their day.
      Aggregated by H3 hex (~174m), filtered by transport mode and time of day, delivered as a REST API.
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <a
        href="mailto:contact@eremat.org?subject=Road quality data — pilot inquiry"
        class="inline-flex rounded-lg bg-primary px-6 py-3 font-semibold text-bg transition-opacity hover:opacity-90"
      >
        Request a pilot dataset
      </a>
      <a
        href="#api"
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 font-semibold text-white transition-colors hover:border-primary/60"
      >
        See the API
      </a>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <h2 class="text-2xl font-bold md:text-3xl">Who this is for.</h2>

      <div class="mt-12 grid gap-px md:grid-cols-3" style="background:theme('colors.border')">
        <div class="bg-bg px-8 py-10">
          <div class="mb-4 h-1 w-8 rounded-full bg-movement" />
          <h3 class="font-semibold text-white">Insurance telematics</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Road roughness is a loss predictor. Our vibration scores give you street-level surface
            quality correlated with real trips — without deploying any hardware.
            Enriches UBI risk models with data that isn't in any existing dataset.
          </p>
        </div>
        <div class="bg-bg px-8 py-10">
          <div class="mb-4 h-1 w-8 rounded-full bg-pressure" />
          <h3 class="font-semibold text-white">Routing & navigation</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Cyclists, pedestrians, and micro-mobility users want smooth routes — not just fast ones.
            Road quality scores as a routing cost layer. Integrates as a tile overlay or via REST.
          </p>
        </div>
        <div class="bg-bg px-8 py-10">
          <div class="mb-4 h-1 w-8 rounded-full bg-light" />
          <h3 class="font-semibold text-white">City infrastructure</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Continuous road condition monitoring without deploying sensor hardware or sending inspection vehicles.
            Identify deteriorating streets before they become potholes.
            Updated as residents go about their day.
          </p>
        </div>
        <div class="bg-bg px-8 py-10">
          <div class="mb-4 h-1 w-8 rounded-full bg-quality" />
          <h3 class="font-semibold text-white">Environmental research</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Night-only light lux splits enable street-level light pollution mapping.
            Magnetic field readings add electromagnetic exposure data — useful for dark sky,
            urban ecology, and telecom tower research.
          </p>
        </div>
        <div class="bg-bg px-8 py-10">
          <div class="mb-4 h-1 w-8 rounded-full bg-pressure" />
          <h3 class="font-semibold text-white">Urban mobility analytics</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            WiFi access point density is a urban density proxy collected at no extra cost.
            Combine with transport mode inference (walking vs. vehicle) to segment streets by
            pedestrian activity vs. car traffic — without any surveys.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Live API -->
  <section id="api" class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">Live endpoint</p>
      <h2 class="mt-3 text-2xl font-bold md:text-3xl">Try the data right now.</h2>
      <p class="mt-4 max-w-lg text-muted">
        No API key required. Returns real road vibration data — vehicle-only, transport-filtered — from active contributors.
      </p>

      <div class="mt-10 space-y-6 max-w-3xl">
        <!-- Endpoint block -->
        <div class="rounded-xl border border-border bg-bg p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">All cells — last 30 days</p>
          <code class="block text-sm text-primary break-all">
            GET {API_BASE}/api/tiles/road-quality
          </code>
        </div>

        <div class="rounded-xl border border-border bg-bg p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Bounding box filter</p>
          <code class="block text-sm text-primary break-all">
            GET {API_BASE}/api/tiles/road-quality?sw_lat=48.82&sw_lng=2.28&ne_lat=48.90&ne_lng=2.42
          </code>
          <p class="mt-3 text-xs text-muted">Replace coordinates with any city bounding box.</p>
        </div>

        <!-- Response schema -->
        <div class="rounded-xl border border-border bg-bg p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">Response shape</p>
          <pre class="text-sm text-white overflow-x-auto"><code>{`{
  "resolution": 9,
  "hexSize": "~174m",
  "window": "30d",
  "count": 412,
  "tiles": [
    {
      "h3":        "891fb4664c3ffff",
      "lat":       48.8566,
      "lng":       2.3522,
      "vibration": 0.412,   // 0–1 normalised, higher = rougher
      "samples":   38,
      "lastSeen":  "2026-07-05"
    }
  ]
}`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Data spec -->
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">Data spec</p>
      <h2 class="mt-3 text-2xl font-bold md:text-3xl">What you're actually getting.</h2>
      <p class="mt-4 max-w-lg text-muted">No PII. No raw device data. Aggregated spatial readings, updated continuously as contributors move.</p>

      <div class="mt-10 space-y-3 max-w-2xl">
        {[
          ['Road vibration',   'Vehicle-only (transport_mode filter removes walking noise). 0–1 normalised accel std dev. ≥3 samples per hex.'],
          ['Ambient light',    'Lux — split into day (06:00–21:00) and night (22:00–06:00). Night split is the light pollution signal.'],
          ['Magnetic field',   'µT average per hex — electromagnetic exposure mapping, EMF sensitivity research.'],
          ['WiFi density',     'Count of visible access points — urban density proxy without SSIDs or MACs. Pedestrian vs. vehicle segmentable.'],
          ['Air pressure',     'hPa per hex — altitude validation, microclimate indicators.'],
          ['Transport mode',   'Inferred from GPS speed: stationary / walking / vehicle / unknown. Used to segment all other signals.'],
          ['Resolution',       'H3 res 9 (~174m hex) — ~11 hexes per typical city block'],
          ['GPS accuracy filter', 'Batches with accuracy > 100m excluded — bad GPS fixes don't pollute hex cells.'],
          ['Update cadence',   'Continuous — as contributors upload, cells refresh'],
          ['Window',           '30-day rolling'],
          ['Formats',          'JSON via REST · GeoJSON · CSV on request'],
          ['Privacy',          'Readings anonymized at ingest. No route, no identity, no PII ever stored.'],
          ['Auth',             'Pilot access: open. Production: API key (email us).'],
        ].map(([k, v]) => (
          <div class="flex gap-6 border-b border-border pb-3 last:border-0">
            <p class="w-36 shrink-0 text-xs font-semibold uppercase tracking-wider text-muted">{k}</p>
            <p class="text-sm text-white">{v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Honest status -->
  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">Honest status</p>
      <h2 class="mt-3 text-2xl font-bold md:text-3xl">Early, real, and growing.</h2>
      <p class="mt-5 max-w-xl text-muted leading-relaxed">
        Coverage depends on where contributors live and commute. Dense urban areas have rich,
        high-sample data. Sparse areas have less. If you need complete national coverage,
        we're not there yet. If you're willing to pilot in specific corridors or cities
        where coverage exists — and shape what gets built next — talk to us.
      </p>
      <p class="mt-5 max-w-xl text-muted leading-relaxed">
        We're looking for one serious first partner. Pilot datasets are free.
        Commercial licensing is negotiated based on coverage area and use case.
      </p>
      <a
        href="mailto:contact@eremat.org?subject=Road quality data — pilot inquiry"
        class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-semibold text-bg transition-opacity hover:opacity-90"
      >
        Email us directly
      </a>
    </div>
  </section>

  <Footer />
</Layout>
