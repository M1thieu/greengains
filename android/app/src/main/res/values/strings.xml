<resources>
    <string name="app_name">GreenGains</string>
    <!-- MapLibre GL requires a non-empty token; Protomaps auth is handled via URL key -->
    <string name="mapbox_access_token">maplibre_no_token_needed</string>

    <!-- Foreground service notification — title = status, body = count or instruction -->
    <string name="notification_status_collecting">Mapping your city</string>
    <string name="notification_paused_title">Paused</string>
    <string name="notification_paused_body">Tap Resume to keep your map growing</string>
    <string name="notification_collecting_no_upload">Waiting for first upload…</string>
    <plurals name="notification_readings_today">
        <item quantity="one">1 upload today</item>
        <item quantity="other">%d uploads today</item>
    </plurals>
    <!-- %1$d = today count, %2$d = lifetime total -->
    <string name="notification_readings_with_total">%1$d today · %2$d total uploads</string>

    <!-- Notification actions -->
    <string name="notification_action_pause">Pause</string>
    <string name="notification_action_resume">Resume</string>

    <!-- Background worker notification -->
    <string name="notification_worker_title">GreenGains — processing data</string>
    <string name="notification_worker_body">Finishing your latest upload</string>

    <!-- Streak-at-risk notification — fires once at end of day if streak > 1 and no upload today -->
    <string name="notification_streak_channel_name">Streak Reminders</string>
    <!-- %1$d = streak days -->
    <string name="notification_streak_title">%1$d-day streak — still going?</string>
    <string name="notification_streak_body">You haven\'t mapped anything today. Open the app to keep your streak alive.</string>

    <!-- Zone discovery notification -->
    <string name="notification_zone_channel_name">Zone Discoveries</string>
    <string name="notification_zone_title">New zone mapped!</string>
    <!-- %1$d = total zones -->
    <string name="notification_zone_body_single">%1$d zones total — keep going!</string>
    <!-- %1$d = new zones, %2$d = total zones -->
    <string name="notification_zone_body_multiple">+%1$d new zones · %2$d total</string>
</resources>
