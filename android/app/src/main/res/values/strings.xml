<resources>
    <string name="app_name">GreenGains</string>
    <!-- MapLibre GL requires a non-empty token; Protomaps auth is handled via URL key -->
    <string name="mapbox_access_token">maplibre_no_token_needed</string>

    <!-- Foreground service notification — title = status, body = progress (zone-first) -->
    <string name="notification_status_collecting">Mapping your neighborhood</string>
    <string name="notification_status_stationary">Running in background</string>
    <string name="notification_paused_title">Paused</string>
    <string name="notification_paused_body">Resume to keep mapping</string>
    <string name="notification_collecting_no_upload">Move around to start mapping</string>
    <!-- Zone-first body strings — shown when zonesTotal > 0 -->
    <!-- %1$d = zones total -->
    <string name="notification_body_zones_uploading">%1$d zones · uploading now</string>
    <string name="notification_body_zones_collecting">%1$d zones mapped</string>
    <!-- %1$d = zones total (stationary state) -->
    <string name="notification_body_stationary">%1$d zones · standing by</string>
    <!-- %1$d = zones total (paused state) -->
    <string name="notification_body_paused_zones">%1$d zones on your map</string>
    <!-- Fallback body strings when no zones yet — readings count -->
    <!-- %d = readings count -->
    <string name="notification_readings_uploading">%d readings · uploading now</string>

    <!-- Expanded BigText — compact status line: "Synced 5min ago  ·  moving" -->
    <string name="notification_sync_uploading">Syncing now</string>
    <!-- %s = elapsed time e.g. "5min ago" -->
    <string name="notification_sync_uploaded">Synced %s</string>
    <string name="notification_sync_none">Not synced yet</string>
    <string name="notification_motion_moving">moving</string>
    <string name="notification_motion_stationary">still</string>
    <string name="notification_expanded_paused">Tap Resume to keep mapping.</string>

    <!-- Notification actions -->
    <string name="notification_action_pause">Pause</string>
    <string name="notification_action_resume">Resume</string>
    <string name="notification_action_stop">Stop</string>

    <!-- Upload elapsed time — shown in expanded status line -->
    <string name="notification_upload_just_now">just now</string>
    <string name="notification_upload_minutes_ago">%dmin ago</string>
    <string name="notification_upload_hours_ago">%dh ago</string>
    <string name="notification_upload_yesterday">yesterday</string>

    <!-- Variant B notification — title, subtext chip, body, expanded -->
    <string name="notif_title_contributing">Mapping</string>
    <string name="notif_subtext_active">ACTIVE</string>
    <string name="notif_subtext_stationary">STATIONARY</string>
    <string name="notif_body_starting">Starting up…</string>
    <string name="notif_motion_moving">Moving</string>
    <string name="notif_motion_still">Still</string>
    <!-- %1$d = hours, %2$d = minutes (zero-padded) -->
    <string name="notif_duration_hours_min">%1$dh %2$02dmin</string>
    <!-- %1$d = minutes -->
    <string name="notif_duration_minutes">%1$dmin</string>

    <!-- Notification dashboard rows -->
    <!-- %1$d = zones, %2$s = duration -->
    <string name="notif_dash_zones_duration">%1$d zones  ·  %2$s</string>
    <!-- %1$d = zones only -->
    <string name="notif_dash_zones">%1$d zones</string>
    <!-- %1$s = lux label, %2$s = hPa label -->
    <string name="notif_dash_sensors">%1$s  ·  %2$s</string>
    <!-- single sensor -->
    <string name="notif_dash_sensor_lux">%1$s</string>
    <string name="notif_dash_sensor_hpa">%1$s</string>

    <!-- Background worker notification -->
    <string name="notification_worker_title">GreenGains · syncing</string>
    <string name="notification_worker_body">Saving your map data</string>

    <!-- Re-engagement notification — fires if no activity today -->
    <string name="notification_streak_channel_name">Map Reminders</string>
    <string name="notification_streak_title">Your map is waiting</string>
    <string name="notification_streak_body">Open the app and start moving — every new street fills in your map.</string>

    <!-- Weekly ambient digest — passive map summary, no call-to-action -->
    <string name="notification_weekly_channel_name">Weekly Map Update</string>
    <string name="notification_weekly_title">Your map this week</string>
    <!-- %1$d = new zones, %2$d = total -->
    <string name="notification_weekly_body_growth">+%1$d new zones — %2$d total on your map</string>
    <!-- %1$d = total (no change week-over-week) -->
    <string name="notification_weekly_body_stable">%1$d zones mapped so far</string>
    <string name="sensor_lux_dark">Pitch dark</string>
    <string name="sensor_lux_indoor">Dim</string>
